/*
 * Toucan Wireless Piantor keymap
 * Ported from zmk_chocofi corne.keymap (Dvorak + homerow mods)
 * Outer left col:  RCLK / LCLK / MCLK
 * Outer right col: SCRL_UP / MUTE / SCRL_DN  (base); VOL_UP / MUTE / VOL_DN (NUMS)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define NUMS 1
#define SYMS 2
#define NAV  3

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        td_esc: tap_dance_esc {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp TAB>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        nav_layer {
            if-layers = <NUMS SYMS>;
            then-layer = <NAV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
// ╭──────┬──────┬──────┬──────┬──────┬──────╮   ╭──────┬──────┬──────┬──────┬──────┬──────╮
// │ RCLK │  '   │  ,   │  .   │  P   │  Y   │   │  F   │  G   │  C   │  R   │  L   │SCR↑  │
// │ LCLK │ A/⌘  │ O/⌥  │ E/⌃  │ U/⇧  │  I   │   │  D   │ H/⇧  │ T/⌃  │ N/⌥  │ S/⌘  │ MUTE │
// │ MCLK │  ;   │  Q   │  J   │  K   │  X   │   │  B   │  M   │  W   │  V   │  Z   │SCR↓  │
// ╰──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────╯
//                      │ES/TB │ SPC  │ NUMS │   │ SYMS │ ENT  │ BSPC │
//                      ╰──────┴──────┴──────╯   ╰──────┴──────┴──────╯
            bindings = <
   &mkp RCLK     &kp SQT      &kp COMMA    &kp DOT      &kp P        &kp Y      &kp F    &kp G        &kp C        &kp R        &kp L        &msc SCRL_UP
   &mkp LCLK     &hm LGUI A   &hm LALT O   &hm LCTRL E  &hm LSHFT U  &kp I      &kp D    &hm RSHFT H  &hm RCTRL T  &hm RALT N   &hm RGUI S   &kp C_MUTE
   &mkp MCLK     &kp SEMI     &kp Q        &kp J        &kp K        &kp X      &kp B    &kp M        &kp W        &kp V        &kp Z        &msc SCRL_DOWN
                                           &td_esc      &kp SPACE    &mo NUMS   &mo SYMS &kp RET      &kp BSPC
            >;
        };

        nums {
            display-name = "NUMS";
// ╭──────┬──────┬──────┬──────┬──────┬──────╮   ╭──────┬──────┬──────┬──────┬──────┬──────╮
// │      │  F1  │  F2  │  F3  │  F4  │ DEL  │   │ DEL  │  7   │  8   │  9   │ NUM  │ VOLU │
// │      │ F5/⌘ │ F6/⌥ │ F7/⌃ │ F8/⇧ │      │   │ TAB  │ 4/⇧  │ 5/⌃  │ 6/⌥  │ ./⌘  │ MUTE │
// │      │  F9  │  F10 │  F11 │  F12 │      │   │  0   │  1   │  2   │  3   │ ESC  │ VOLD │
// ╰──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────╯
//                      │      │ SPC  │      │   │      │ ENT  │ BSPC │
//                      ╰──────┴──────┴──────╯   ╰──────┴──────┴──────╯
            bindings = <
   &trans  &kp F1       &kp F2       &kp F3       &kp F4       &kp DEL    &kp DEL  &kp N7       &kp N8       &kp N9       &kp KP_NUM   &kp C_VOL_UP
   &trans  &hm LGUI F5  &hm LALT F6  &hm LCTRL F7 &hm LSHFT F8 &none      &kp TAB  &hm RSHFT N4 &hm RCTRL N5 &hm RALT N6  &hm RGUI DOT &kp C_MUTE
   &trans  &kp F9       &kp F10      &kp F11      &kp F12      &none      &kp N0   &kp N1       &kp N2       &kp N3       &kp ESC      &kp C_VOL_DN
                                     &trans       &kp SPACE    &trans     &trans   &kp RET      &kp BSPC
            >;
        };

        syms {
            display-name = "SYMS";
// ╭──────┬──────┬──────┬──────┬──────┬──────╮   ╭──────┬──────┬──────┬──────┬──────┬──────╮
// │      │  ,   │  %   │  @   │  '   │  :   │   │  ^   │  &   │  *   │  $   │      │      │
// │      │ //⌘  │ {/⌥  │ ;/⌃  │ (/⇧  │  +   │   │  -   │ )/⇧  │ =/⌃  │ }/⌥  │ `/⌘  │      │
// │      │  #   │  ~   │  &   │  ?   │  |   │   │  \   │  !   │  [   │  ]   │  _   │      │
// ╰──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────╯
//                      │ GUI  │ SPC  │      │   │      │ ENT  │ BSPC │
//                      ╰──────┴──────┴──────╯   ╰──────┴──────┴──────╯
            bindings = <
   &trans  &kp COMMA      &kp PRCNT     &kp AT        &kp SQT       &kp COLON   &kp CARET  &kp AMPS       &kp ASTRK       &kp DLLR      &none          &trans
   &trans  &hm LGUI FSLH  &hm LALT LBRC &hm LCTRL SEMI &hm LSHFT LPAR &kp PLUS  &kp MINUS  &hm RSHFT RPAR &hm RCTRL EQUAL &hm RALT RBRC &hm RGUI GRAVE &trans
   &trans  &kp HASH       &kp TILDE     &kp AMPS      &kp QMARK     &kp PIPE    &kp BSLH   &kp EXCL       &kp LBKT        &kp RBKT      &kp UNDER      &trans
                                        &kp LGUI      &kp SPACE     &trans      &trans     &kp RET        &kp BSPC
            >;
        };

        nav {
            display-name = "NAV";
// ╭──────┬──────┬──────┬──────┬──────┬──────╮   ╭──────┬──────┬──────┬──────┬──────┬──────╮
// │      │      │      │      │      │      │   │BTCLR │ BT1  │ BT2  │ BT3  │ BT4  │ BLE  │
// │      │      │ PRV/⌥│ PP/⌃ │ NXT/⇧│ VOLU │   │ DEL  │ ←/⇧  │ ↑/⌃  │ ↓/⌥  │ →/⌘  │      │
// │      │UNLCK │      │      │      │ VOLD │   │ ESC  │ HOME │ PGDN │ PGUP │ END  │      │
// ╰──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────╯
//                      │      │ SPC  │      │   │      │ ENT  │ BSPC │
//                      ╰──────┴──────┴──────╯   ╰──────┴──────┴──────╯
            bindings = <
   &trans  &none          &none           &none          &none           &none          &bt BT_CLR &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &out OUT_BLE
   &trans  &none          &hm LALT C_PREV &hm LCTRL C_PP &hm LSHFT C_NEXT &kp C_VOL_UP  &kp DEL   &hm RSHFT LEFT &hm RCTRL UP  &hm RALT DOWN &hm RGUI RIGHT &trans
   &trans  &studio_unlock &none           &none          &none           &kp C_VOL_DN   &kp ESC   &kp HOME       &kp PG_DN     &kp PG_UP     &kp END        &trans
                                          &trans         &kp SPACE       &trans         &trans    &kp RET        &kp BSPC
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
